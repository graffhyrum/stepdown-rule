{
	"name": "@stepdown/analyzer",
	"version": "0.3.0",
	"private": true,
	"description": "TypeScript AST analyzer that enforces the stepdown rule for function organization",
	"keywords": [
		"ast",
		"code-quality",
		"function-organization",
		"static-analysis",
		"stepdown-rule",
		"typescript"
	],
	"license": "MIT",
	"author": "",
	"repository": {
		"type": "git",
		"url": "https://github.com/graffhyrum/stepdown-rule.git"
	},
	"bin": {
		"stepdown-rule": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"SKILL.md"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "bun scripts/build.ts && bun run build:declaration",
		"build:declaration": "bunx tsgo --emitDeclarationOnly --project tsconfig.types.json",
		"postbuild": "bun run --shell bun remove-buildinfo",
		"remove-buildinfo": "bun scripts/remove-buildinfo.ts",
		"compile:release": "bun scripts/compile-release.ts",
		"compile:bench": "bun scripts/compile-size-bench.ts",
		"dev": "bun run src/cli.ts",
		"test": "bun test",
		"test:coverage": "AGENT=1 bun test --coverage ",
		"typecheck": "bunx tsgo --noEmit -p tsconfig.check.json",
		"check": "bunx oxlint . && bunx oxfmt --check .",
		"fix": "bunx oxlint --fix . && bunx oxfmt --write .",
		"custom-hooks": "bun run scripts/rule-validator.ts && bun run dist/cli.js fix",
		"fastvet": "bun run build && bun typecheck && bun fix && bun run custom-hooks  && bun run test:coverage",
		"vet": "bun fastvet",
		"changeset": "changeset",
		"version": "changeset version"
	},
	"dependencies": {
		"arktype": "^2.2.3",
		"commander": "^14.0.3",
		"glob": "^13.0.6",
		"minimatch": "^10.2.6",
		"picocolors": "^1.1.1",
		"typescript": "^5.9.3"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.5",
		"oxfmt": "^0.46.0",
		"oxlint": "^1.77.0"
	},
	"peerDependencies": {
		"@typescript/native-preview": "^7.0.0-dev.20260219.1"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
