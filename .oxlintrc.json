{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": [
		"node_modules/**",
		"dist/**",
		"build/**",
		".idea/**",
		"public/**",
		"fixtures/**",
		"**/*.test.ts"
	],
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"rules": {},
	"env": {
		"builtin": true
	}
}
